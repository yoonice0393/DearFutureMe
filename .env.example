# Copy to .env.local for local development. Never commit real values.
#
# ── Browser (VITE_*) ─────────────────────────────────────────────
# Everything prefixed VITE_ is bundled into the public JavaScript.
# Only put PUBLIC values here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_CONTACT_EMAIL=privacy@yourdomain.example

# ── Server only (Supabase Edge Function secrets) ─────────────────
# Do NOT put these in .env.local. Set them with:
#   npx supabase secrets set --env-file supabase/.env.secrets
# (supabase/.env.secrets is git-ignored; see supabase/.env.secrets.example)
