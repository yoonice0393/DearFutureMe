# Server-only secrets for Supabase Edge Functions.
# Generate real values with:  node scripts/gen-secrets.mjs
# Upload with:                npx supabase secrets set --env-file supabase/.env.secrets
LETTER_KEY=base64-of-32-random-bytes
LINK_SECRET=at-least-32-random-characters
EMAIL_HASH_SECRET=at-least-32-random-characters
SITE_ORIGINS=http://localhost:5173
DEV_MODE=true
