// Cloudflare Workers static-assets deploy (Workers Builds runs `npx wrangler deploy`
// after `npm run build`). No server code: the Worker only serves dist/.
//   - /about → about.html (html_handling), unknown paths → index.html (SPA)
//   - dist/_headers (CSP, HSTS…) is applied by Cloudflare and not served itself
// Keeping this file in the repo stops wrangler from auto-configuring the project.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dearfutureme",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false }
}
